{
  "name": "dsh-plugin-chat-search",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "In-session chat text search: find, step through, and highlight matches inside the current conversation without mutating its DOM.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "chat-search",
    "find-in-conversation",
    "highlight",
    "css-custom-highlight"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/fakeNihilist/dsh-plugins.git",
    "directory": "packages/chat-search"
  },
  "homepage": "https://github.com/fakeNihilist/dsh-plugins/tree/main/packages/chat-search#readme",
  "author": "fakeNihilist",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "test:dom": "node --test \"test/dom/*.test.js\""
  },
  "devDependencies": {
    "jsdom": "^26.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  }
}
