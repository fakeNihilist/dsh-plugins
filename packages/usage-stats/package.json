{
  "name": "dsh-plugin-usage-stats",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Whole-corpus token usage statistics: daily and cumulative tokens, cache hit rate, per-model breakdown, and a year-long activity heatmap.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis-plugin",
    "token-usage",
    "usage-statistics",
    "dashboard",
    "heatmap",
    "cache-hit-rate"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/fakeNihilist/dsh-plugins.git",
    "directory": "packages/usage-stats"
  },
  "homepage": "https://github.com/fakeNihilist/dsh-plugins/tree/main/packages/usage-stats#readme",
  "author": "fakeNihilist",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "usage-fold.js",
    "checkpoint.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "verify:logs": "node verify/real-logs.js",
    "verify:cut": "node verify/cut-compare.js",
    "verify:payload": "node verify/payload-conformance.js",
    "verify:read": "node verify/session-read-audit.js",
    "verify:v0": "node verify/v0-artifacts.js",
    "verify:corpus": "node verify/corpus-pass.js",
    "verify:trend": "node verify/trend-inspect.js",
    "verify:replay": "node verify/live-replay.js",
    "verify:gain": "node verify/incremental-gain.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
