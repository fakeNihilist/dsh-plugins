{
  "name": "dsh-plugin-notification",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Desktop notifications for DeepSeek Harness: a distinct sound when a task finishes and when a Session is waiting for approval or an answer, with click-to-open Session navigation.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis-plugin",
    "notification",
    "desktop-notification",
    "windows-notification",
    "approval",
    "attention",
    "click-to-open"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/fakeNihilist/dsh-plugins.git",
    "directory": "packages/notification"
  },
  "homepage": "https://github.com/fakeNihilist/dsh-plugins/tree/main/packages/notification#readme",
  "author": "fakeNihilist",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.js\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
